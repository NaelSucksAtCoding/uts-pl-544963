# Contoh konfigurasi untuk docker-compose.yml.
# Salin menjadi .env lalu isi nilainya:  cp .env.example .env
# Berkas .env tidak ikut di-commit (lihat .gitignore).

# Kunci aplikasi Laravel. Buat dengan perintah:
#   php -r "echo 'base64:'.base64_encode(random_bytes(32));"
APP_KEY=

# Kredensial database MySQL
DB_DATABASE=futsal
DB_USERNAME=futsal
DB_PASSWORD=ganti_dengan_password_kuat
DB_ROOT_PASSWORD=ganti_dengan_password_root_kuat

# Port di laptop
BACKEND_PORT=8000
FRONTEND_PORT=8080

# Password admin Grafana (username: admin). Wajib diisi, jangan pakai "admin".
GRAFANA_ADMIN_PASSWORD=ganti_dengan_password_grafana_kuat
