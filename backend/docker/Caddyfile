# Konfigurasi FrankenPHP (dibangun di atas web server Caddy).
# https://frankenphp.dev/docs/config

{
	skip_install_trust
	frankenphp
	# Metrik request (jumlah, status, waktu tanggap) untuk Prometheus.
	metrics
}

# Metrik untuk Prometheus. Port ini tidak dibuka ke laptop di docker-compose.yml,
# jadi hanya bisa dijangkau dari jaringan Compose.
:9180 {
	metrics /metrics
}

# HTTP biasa di port 80; HTTPS ditangani di luar container.
:80 {
	# Access log ke stdout, sehingga setiap request yang dilayani FrankenPHP
	# terlihat di "docker compose logs backend".
	# Header dan alamat IP klien tidak ikut dicatat, supaya log bebas data pribadi.
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>headers delete
				request>remote_ip delete
				request>remote_port delete
				request>client_ip delete
				resp_headers delete
			}
		}
	}

	# Healthcheck berjalan terus-menerus, jadi tidak perlu memenuhi access log.
	log_skip /health

	root public/
	encode zstd br gzip

	# Meneruskan request ke public/index.php milik Laravel.
	php_server
}
